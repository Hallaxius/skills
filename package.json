{
  "name": "@hallaxius/skills",
  "version": "1.0.0",
  "description": "Unofficial MCP server for skills.sh - The Agent Skills Directory",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "skills",
    "agent-skills",
    "skills.sh",
    "ai-agents",
    "claude-code",
    "cursor",
    "opencode",
    "anthropic"
  ],
  "license": "MIT",
  "author": "Hallaxius",
  "homepage": "https://github.com/hallaxius/skills#readme",
  "bugs": {
    "url": "https://github.com/hallaxius/skills/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hallaxius/skills.git"
  },
  "type": "module",
  "bin": {
    "skills-sh-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run scripts/mcp-smoke.ts",
    "lint:pack": "publint",
    "prepack": "bun run typecheck && bun test && bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "publint": "^0.3.24",
    "typescript": "^7.0.2"
  }
}